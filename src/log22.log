          <WeatherListItem 
            key={city.id}
            city={city}
            weatherData={citiesWeatherData[city.id]}
            isActive={city.id === activeCityId}
            onSelect={onSelectCity}
            onRefresh={onRefreshCity}
            onDelete={onDeleteCity}
            onToggleFavorite={onToggleFavorite}
            setViewMode={setViewMode}
          />
        ))}
      </WeatherList>
    </div>
  );
};